# --- PostgreSQL ---
POSTGRES_DB=db_name
POSTGRES_USER=db_user
POSTGRES_PASSWORD=password_db

# --- JWT ---
JWT_SECRET=token
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12

# --- Первый оператор (создаётся при старте) ---
OPERATOR_EMAIL=mail.ru
OPERATOR_PASSWORD=password

# --- CDR_OUT ---
CDR_TIMEZONE=Europe/Moscow
CDR_AUTOLOAD=false
MAX_UPLOAD_MB=200

# --- Веб ---
FRONTEND_PORT=8080
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
LOG_LEVEL=INFO
RESET_TOKEN_TTL_MINUTES=60

# --- SMTP ---
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=user@email.example
SMTP_PASSWORD=password
SMTP_FROM=Антифрод <user@email.example>
SMTP_USE_TLS=true
